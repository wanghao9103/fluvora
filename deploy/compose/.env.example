FLUVORA_PUBLIC_IP=127.0.0.1
FLUVORA_PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8093
FLUVORA_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FLUVORA_REGION=local
FLUVORA_BUILD_VERSION=0.1.0
GRAFANA_ADMIN_PASSWORD=replace-this-grafana-admin-password
FLUVORA_POSTGRES_PASSWORD=replace-this-postgres-password
FLUVORA_NATS_TOKEN=replace-this-nats-token-with-at-least-24-random-bytes

# Leave the bucket empty to use the durable local `media` volume.
# For S3-compatible storage set the bucket/region and, when needed, endpoint/credentials.
FLUVORA_OBJECT_STORE_BUCKET=
FLUVORA_OBJECT_STORE_REGION=us-east-1
FLUVORA_OBJECT_STORE_ENDPOINT=
FLUVORA_OBJECT_STORE_ACCESS_KEY=
FLUVORA_OBJECT_STORE_SECRET_KEY=
FLUVORA_OBJECT_STORE_PREFIX=fluvora
# Only enable for an isolated local S3 emulator.
FLUVORA_OBJECT_STORE_ALLOW_HTTP=false
# Zero disables automatic deletion.
FLUVORA_VOD_RETENTION_HOURS=0
FLUVORA_LIVE_RETENTION_HOURS=0

# Replace every value before exposing the stack outside a developer machine.
FLUVORA_TOKEN_SECRET=replace-this-token-secret-with-at-least-32-random-bytes
# Optional rotation form: comma-separated active key first, followed by retiring keys.
# FLUVORA_TOKEN_SECRETS=replace-active-key-at-least-32-bytes,replace-retiring-key-at-least-32-bytes
FLUVORA_GIFT_WEBHOOK_SECRET=replace-this-gift-webhook-secret-with-32-random-bytes
FLUVORA_MEDIA_CONTROL_TOKEN=replace-this-media-control-token
FLUVORA_GATEWAY_TOKEN=replace-this-gateway-control-token
FLUVORA_WORKER_TOKEN=replace-this-worker-control-token
FLUVORA_STATUS_TOKEN=replace-this-status-heartbeat-token
FLUVORA_TURN_USERNAME=fluvora
FLUVORA_TURN_PASSWORD=replace-this-static-turn-password
FLUVORA_TURN_REALM=turn.fluvora.local
FLUVORA_TURN_NONCE_SECRET=replace-this-turn-nonce-secret-with-32-random-bytes
FLUVORA_TURN_REST_SECRET=replace-this-turn-rest-secret-with-32-random-bytes
# Required for this loopback/local Compose topology; keep false on public deployments.
FLUVORA_TURN_ALLOW_PRIVATE_PEERS=true
